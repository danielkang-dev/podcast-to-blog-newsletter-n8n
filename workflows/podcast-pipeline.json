        "jsCode": "// === Build the paste-ready blog email (workaround mode) ===\n// SiteGround SG-CAPTCHA is blocking the WP REST API, so instead of creating\n// a draft via API we email the host the raw HTML to paste into WordPress manually.\n// Sent as PLAIN TEXT so the HTML source is copyable (not rendered away).\nconst p = $('Parse & validate Claude JSON').first().json;\n\nconst body =\n  'New blog draft ready to paste into WordPress.\\n\\n' +\n  '=== TITLE (paste into the title field) ===\\n' +\n  p.blog_title + '\\n\\n' +\n  '=== META DESCRIPTION (Yoast/SEO field) ===\\n' +\n  p.blog_meta + '\\n\\n' +\n  '=== BLOG BODY (paste into the WordPress editor in \"Code\"/HTML mode) ===\\n' +\n  p.blog_body + '\\n\\n' +\n  '--- how to paste ---\\n' +\n  '1. New Post in WordPress.\\n' +\n  '2. Switch the editor to Code/HTML view (the ⋮ menu > Code editor).\\n' +\n  '3. Paste the BLOG BODY section above.\\n' +\n  '4. Switch back to Visual view, add title + meta, save as Draft.\\n';\n\nreturn [{ json: {\n  guid: p.guid,\n  blog_email_subject: '[Cards To The Moon] Blog draft ready to paste — ' + p.blog_title,\n  blog_email_body: body\n}}];"
