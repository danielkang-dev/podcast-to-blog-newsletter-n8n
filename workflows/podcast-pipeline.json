      "parameters": {
        "jsCode": "// === Back-catalogue guard + episode filter (FAIL-SAFE) ===\n// Prevents transcribing all 312 episodes on first run, and skips trailers/shorts.\nconst MAX_AGE_DAYS     = 7;   // only consider episodes published in the last N days\nconst MIN_DURATION_SEC = 600; // skip anything shorter than N seconds (trailers/shorts)\nconst MAX_PER_RUN      = 1;   // hard cap on episodes processed per run\n\nconst now = Date.now();\nconst kept = [];\n\nfor (const it of $input.all()) {\n  const d = it.json;\n  // RSS Read field names vary by feed -- adjust if your feed differs:\n  const pubDate = d.isoDate || d.pubDate || d.published;\n  const guid    = d.guid || d.id || d.link;\n  const title   = d.title || '';\n  const enclosureUrl = (d.enclosure && d.enclosure.url) || d.enclosureUrl || d.link;\n\n  // duration may arrive as \"HH:MM:SS\", seconds, or under itunes:duration\n  let durationSec = 0;\n  const rawDur = d['itunes:duration'] || d.duration;\n  if (typeof rawDur === 'number') durationSec = rawDur;\n  else if (typeof rawDur === 'string' && rawDur.includes(':'))\n    durationSec = rawDur.split(':').map(Number).reduce((a,b)=>a*60+b,0);\n  else if (rawDur) durationSec = Number(rawDur) || 0;\n\n  const ageDays = pubDate ? (now - new Date(pubDate).getTime())/86400000 : 999;\n  if (ageDays > MAX_AGE_DAYS) continue;\n  if (durationSec && durationSec < MIN_DURATION_SEC) continue;\n  if (!guid || !enclosureUrl) continue;\n\n  kept.push({ json: {\n    guid, title, enclosureUrl, durationSec, pubDate,\n    status: 'processing',\n    claimed_at: new Date().toISOString(),\n    retry_count: 0,\n    error_note: ''\n  }});\n}\n\nkept.sort((a,b) => new Date(b.json.pubDate) - new Date(a.json.pubDate));\nreturn kept.slice(0, MAX_PER_RUN);"
      },
