      "parameters": {
        "jsCode": "// === Idempotency gate (FAIL-SAFE backbone) ===\n// One ledger row per guid. retry_count on that row = attempts so far.\nconst rows = $input.all().map(i => i.json);\nconst cand = $('Filter to recent episodes').first();\nif (!cand) return [];\n\nconst guid = String(cand.json.guid);\nconst mine = rows.filter(r => String(r.guid || r.GUID || '') === guid);\nconst st = r => String(r.status || '').toLowerCase();\n\nif (mine.some(r => st(r) === 'done')) return [];             // already published\nif (mine.some(r => st(r) === 'failed-permanent')) return []; // already alerted -> stay quiet\n\n// Attempts so far. Legacy duplicate rows still count 1 each.\nconst attempts = Math.max(mine.length, ...mine.map(r => Number(r.retry_count) || 0));\n\nconst RETRY_CAP = 3;\nif (attempts >= RETRY_CAP) {\n  // Routed to the alert branch by the IF node. Fires once; the row then blocks future runs.\n  return [{ json: { ...cand.json, status: 'failed-permanent', retry_count: attempts,\n    error_note: 'Retry cap (' + RETRY_CAP + ') hit ' + new Date().toISOString() } }];\n}\n\n// New or retryable: claim with incremented count (Claim node upserts on guid).\nreturn [{ json: { ...cand.json, status: 'processing', retry_count: attempts + 1,\n  claimed_at: new Date().toISOString(), error_note: '' } }];"
      },
