      "parameters": {
        "jsCode": "// === Audio validation gate (FAIL-CLOSED) ===\n// Confirms the resolved enclosure URL is reachable and looks like audio\n// BEFORE we spend a transcription call. Throws -> Error Workflow on failure.\nconst r = $input.first().json;\nconst status = r.statusCode || (r.headers ? 200 : 0);\nconst ct = (r.headers && (r.headers['content-type'] || r.headers['Content-Type'])) || '';\n\nif (status && status >= 400)\n  throw new Error('Audio URL returned HTTP ' + status + ' -- failing closed.');\nif (ct && !String(ct).toLowerCase().includes('audio'))\n  throw new Error('Audio URL content-type not audio: \"' + ct + '\" -- failing closed.');\n\n// Forward the episode candidate (HTTP node replaced the item, so re-fetch it).\nreturn [ $('Check if new (idempotency gate)').first() ];\n"
      },
      "id": "36f7620a-3a77-404e-92c5-948307ce42d8",
      "name": "Check audio is reachable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5056,
        2544
      ]
    },
    {
      "parameters": {
        "jsCode": "const a = $json; // AssemblyAI completed transcript response\nconst text = a.text || '';\nconst durationSec = a.audio_duration\n  || $('Check if new (idempotency gate)').first().json.durationSec\n  || 0;\n\nif (!text || text.trim().length < 50)\n  throw new Error('Transcript empty / near-empty -- failing closed.');\n\nconst MIN_CHARS_PER_MIN = 300;\nif (durationSec > 0) {\n  const cpm = text.length / (durationSec / 60);\n  if (cpm < MIN_CHARS_PER_MIN)\n    throw new Error('Transcript suspiciously short (' + Math.round(cpm)\n      + ' chars/min) -- possible truncation. Failing closed.');\n}\n\nreturn [{ json: { transcript: text, durationSec } }];"
      },
      "id": "cf9c238f-ec88-4ce3-a786-1da14f8f0b92",
      "name": "Validate transcript length",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6400,
        2448
      ]
    },
    {
      "parameters": {
        "jsCode": "// === Build the Claude request (voice and style guide removed from this copy) ===\nconst ep = $('Check if new (idempotency gate)').first().json;\nconst transcript = $('Validate transcript length').first().json.transcript;\nconst SYSTEM = [\n  // The client's voice and style guide is removed from this showcase copy.\n  // The production prompt sets the voice, the structure of the blog post and\n  // the newsletter blurb, and a list of things not to do.\n  'You are the editorial voice of the podcast. From the transcript, write (1) a blog post and (2) a short newsletter blurb that teases the post.',\n  '',\n  '[VOICE AND STYLE GUIDE REMOVED]',\n  '',\n  'DO NOT',\n  '- Do not invent facts, sales, or quotes not in the transcript.',\n  '',\n  'Return your output in exactly this format, with no other text before or after:',\n  '<blog_title>...</blog_title>',\n  '<blog_meta>...</blog_meta>',\n  '<blog_body>...</blog_body>',\n  '<newsletter_blurb>...</newsletter_blurb>',\n  'blog_body contains raw HTML. Do not escape anything. Do not use JSON.'\n].join('\\n');\nconst USER = 'Episode title: ' + ep.title + '\\n\\nTranscript:\\n' + transcript;\nreturn [{ json: {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 8192,\n  system: SYSTEM,\n  messages: [{ role: 'user', content: USER }]\n}}];"
      },
      "id": "1befcec9-4193-42ff-928e-5782ceff98a1",
      "name": "Build Claude prompt",
