    {
      "parameters": {
        "jsCode": "const d = $json;\nlet raw = '';\nif (Array.isArray(d.content))\n  raw = d.content.filter(b => b.type === 'text').map(b => b.text).join('\\n');\nelse if (typeof d.completion === 'string') raw = d.completion;\nelse raw = JSON.stringify(d);\n\nfunction extract(tag) {\n  const m = raw.match(new RegExp('<' + tag + '>([\\\\s\\\\S]*?)</' + tag + '>'));\n  return m ? m[1].trim() : '';\n}\n\nconst parsed = {\n  blog_title:       extract('blog_title'),\n  blog_meta:        extract('blog_meta'),\n  blog_body:        extract('blog_body'),\n  newsletter_blurb: extract('newsletter_blurb')\n};\n\nfor (const k of ['blog_title','blog_meta','blog_body','newsletter_blurb']) {\n  if (!parsed[k])\n    throw new Error('Missing/empty field: ' + k + ' -- failing closed. Tail: ' + raw.slice(-300));\n}\n\nparsed.guid = $('Check if new (idempotency gate)').first().json.guid;\nreturn [{ json: parsed }];"
      },
