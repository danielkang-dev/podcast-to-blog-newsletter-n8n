      "parameters": {
        "jsCode": "// === Poll counter (FAIL-CLOSED: cap retries so a stuck job can't loop forever) ===\nconst MAX_POLLS = 40; // 40 x 30s wait = ~20 min ceiling (60-90 min episodes need headroom)\n\nconst current = $input.first().json; // latest GET response (status, text, audio_duration, etc.)\n\n// Read the count from THIS node's own previous run, not from the GET response,\n// since the GET response never carries pollCount across loop iterations.\nlet prevCount = 0;\ntry {\n  prevCount = $('Poll counter (fail-closed)').first().json.pollCount || 0;\n} catch (e) {\n  prevCount = 0; // first time through the loop, no previous run exists yet\n}\n\nconst pollCount = prevCount + 1;\n\nif (pollCount > MAX_POLLS) {\n  throw new Error('AssemblyAI transcription exceeded poll ceiling (' + MAX_POLLS\n    + ' attempts, ~20 min) — failing closed. Transcript ID: '\n    + ($('AssemblyAI - submit transcript').first().json.id || 'unknown'));\n}\n\nreturn [{ json: { ...current, pollCount } }];"
      },
